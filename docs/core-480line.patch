diff --git a/rtl/LINES480.md b/rtl/LINES480.md
new file mode 100644
index 0000000..cd29293
--- /dev/null
+++ b/rtl/LINES480.md
@@ -0,0 +1,35 @@
+# 640x480 (PC-9821 31 kHz 480-line) display
+
+The raster stays 800x525 at a 25 MHz pixel clock (~31.5 kHz, 59.5 Hz). In
+480-line mode the first visible line moves from 125 to 45, so all 480 lines of
+a VGA-like frame are shown; otherwise the 400-line window is unchanged.
+
+**Selection:** the text GDC latches its SYNC active-lines parameter (P7/P8,
+AL). AL above 400 sets `LINES480` (`Zet98/GDC/txtgdc.vhd`). This is what the
+PC-9821 BIOS (INT 18h AH=30h, BH bits 5-4 = 11b) and software that programs
+the GDC directly send: AL = 480 (or 475 for 25 rows). Power-on and 400-line
+SYNC tables keep the 640x400 window.
+
+**Path:** `r_LINES480` (CPU clock) -> `video_lines480_sync` (two video-clock
+stages, `Zet98/v17/pc98-lines480.sdc`) -> CRTC98 parent-clock staging -> a
+pixel-clock latch at frame start (VCOMP), so no frame mixes heights. The
+resulting first visible line (`FIRSTV`) drives synccont2 (DE/VISIBLE and VRTC),
+the text layer (knjscr, text_row_counter), GRAPHSCR98 and pegc_raster.
+
+**What shows 480 lines:** text (e.g. 30 rows of 16 lines) and PEGC 256-colour
+packed graphics (use single-page mode, 6Ah = 69h, since 640x480 bytes exceed
+one 256 KB page). The 4-plane 16-colour VRAM is 32 KB per plane and wraps at
+line 409, as on PC-9821 hardware, where 480-line graphics are 256-colour only.
+
+**Port 09A8h:** a readable latch (bit 0, 31 kHz select). The core always scans
+at 31 kHz; BIOSes use the decoded port (reads 00h/01h instead of FFh) to detect
+this support.
+
+**VRTC** is high for the 45 lines before the first visible one (1.44 ms), the
+IRQ2 edge stays at the end of the visible area. The HDMI scaler measures DE,
+so fit/integer scaling adapt automatically (1440x1080 fit, 1280x960 2x).
+
+Tests: `tests/run-crtc-lines480.sh` (visible lines, text on every row, VRTC
+width, switching only at frame boundaries) and `tests/run-txtgdc-lines480.sh`
+(SYNC AL decode). Existing CRTC, graphics-address, PEGC, text and timing
+benches pass unchanged.
diff --git a/rtl/video_lines480_sync.vhd b/rtl/video_lines480_sync.vhd
new file mode 100644
index 0000000..b848284
--- /dev/null
+++ b/rtl/video_lines480_sync.vhd
@@ -0,0 +1,26 @@
+-- SPDX-License-Identifier: GPL-3.0-or-later
+library ieee;
+use ieee.std_logic_1164.all;
+
+-- The text GDC's 480-line bit (SYNC active lines above 400) changes only
+-- when software reprograms the display. Resolve that single CPU-clock bit in
+-- the video clock before CRTC98 stages it and latches it at frame start.
+entity video_lines480_sync is
+    port(video_clk, video_rstn, cpu_lines480 : in std_logic;
+         lines480 : out std_logic);
+end;
+architecture rtl of video_lines480_sync is
+    signal lines480_sync : std_logic_vector(1 downto 0);
+    attribute preserve : boolean;
+    attribute preserve of lines480_sync : signal is true;
+    attribute altera_attribute : string;
+    attribute altera_attribute of lines480_sync : signal is
+        "-name SYNCHRONIZER_IDENTIFICATION FORCED_IF_ASYNCHRONOUS";
+begin
+    process(video_clk, video_rstn) begin
+        if video_rstn='0' then lines480_sync<="00";
+        elsif rising_edge(video_clk) then lines480_sync<=lines480_sync(0) & cpu_lines480;
+        end if;
+    end process;
+    lines480 <= lines480_sync(1);
+end;
diff --git a/tests/crtc_lines480_tb.vhd b/tests/crtc_lines480_tb.vhd
new file mode 100644
index 0000000..75c1f49
--- /dev/null
+++ b/tests/crtc_lines480_tb.vhd
@@ -0,0 +1,112 @@
+library ieee;
+use ieee.std_logic_1164.all;
+entity graphbuf816 is
+    port(clock : in std_logic; data : in std_logic_vector(15 downto 0);
+         rdaddress : in std_logic_vector(6 downto 0);
+         wraddress : in std_logic_vector(5 downto 0); wren : in std_logic;
+         q : out std_logic_vector(7 downto 0));
+end entity;
+architecture test of graphbuf816 is
+begin q <= (others=>'0'); end architecture;
+
+-- 640x480 mode: with LINES480 the CRTC shows 480 visible lines (45-524) of
+-- the unchanged 800x525 raster, text rows continue to line 479, VRTC spans
+-- lines 0-44, and a switch never produces a frame of mixed height.
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+entity crtc_lines480_tb is end;
+architecture test of crtc_lines480_tb is
+    signal clk, raw_rstn, rstn, pixel_clk, de, vsync, vrtc : std_logic := '0';
+    signal done : boolean := false;
+    signal r,g,b : std_logic_vector(3 downto 0);
+    signal lines480 : std_logic := '0';
+begin
+    process begin
+        wait for 6667 ps;
+        if done then wait; end if;
+        clk<=not clk;
+    end process;
+    parent_reset : entity work.reset_release port map(clk,raw_rstn,rstn);
+    dut : entity work.CRTC98 port map(
+        TRAM_ADR=>open,TRAM_DAT=>x"0041",TRAM_ATR=>x"e1",
+        KNJSEL=>open,KNJADR=>open,KNJDAT=>x"ff",
+        GRAMADR=>open,GRAMRD=>open,GRAMACK=>'0',
+        GRAMDAT0=>x"0000",GRAMDAT1=>x"0000",GRAMDAT2=>x"0000",GRAMDAT3=>x"0000",
+        ETRAM_ADR=>open,ETRAM_DAT=>x"00",ECURL=>"00000",ECURC=>"0000000",ECUREN=>'0',
+        ROUT=>r,GOUT=>g,BOUT=>b,HSYNC=>open,VSYNC=>vsync,VIDEOEN=>de,
+        TBASEADDR=>(others=>'0'),HMODE=>'1',VLINES=>"01111",TPITCH=>x"50",
+        GRAPHEN=>'0',DOTPLINE=>"00000",LOWBL=>'0',GCOLOR=>'1',MONOSEL=>"0000",TXTEN=>'1',
+        CURADDR=>(others=>'0'),CURE=>'0',CURUPPER=>0,CURLOWER=>15,CBLINK=>'0',BLINKRATE=>"01000",
+        GBASEADDR0=>(others=>'0'),GBASEADDR1=>(others=>'0'),
+        GLINENUM0=>(others=>'0'),GLINENUM1=>(others=>'0'),GPITCH=>x"28",
+        EMUMODE=>'0',VRTC=>vrtc,HRTC=>open,GPALNO=>open,GPALR=>x"0",GPALG=>x"0",GPALB=>x"0",
+        gclk=>pixel_clk,clk=>clk,rstn=>rstn,LINES480=>lines480);
+
+    process
+        variable visible, white_lines, vrtc_lines, frame : natural;
+        variable line_white : boolean;
+        variable heights : string(1 to 6) := "      ";
+        procedure measure_frame(expect : natural; tag : string) is
+        begin
+            -- start at a VSYNC rising edge
+            wait until rising_edge(vsync);
+            visible:=0;white_lines:=0;vrtc_lines:=0;
+            loop
+                wait until rising_edge(de) or rising_edge(vsync);
+                exit when vsync='1';
+                visible:=visible+1;
+                line_white:=false;
+                while de='1' loop
+                    wait until falling_edge(pixel_clk);
+                    if de='1' and (r & g & b)=x"fff" then line_white:=true; end if;
+                end loop;
+                if line_white then white_lines:=white_lines+1; end if;
+            end loop;
+            assert expect=0 or visible=expect
+                report tag & ": visible lines " & integer'image(visible) severity failure;
+            assert expect=0 or white_lines=visible
+                report tag & ": text rows stop at " & integer'image(white_lines) severity failure;
+            report "PASS " & tag & ": " & integer'image(visible) & " visible lines, text on "
+                & integer'image(white_lines);
+        end procedure;
+    begin
+        raw_rstn<='0';
+        wait for 1 us;
+        raw_rstn<='1';
+        measure_frame(0, "settle");
+        measure_frame(400, "640x400");
+        -- switch in the middle of a frame: that frame keeps its height
+        wait until rising_edge(de);
+        lines480<='1';
+        measure_frame(0, "switch frame");
+        assert visible=400 or visible=480
+            report "Mixed-height frame after the switch: " & integer'image(visible) severity failure;
+        measure_frame(480, "640x480");
+        measure_frame(480, "640x480 again");
+        lines480<='0';
+        measure_frame(0, "switch back");
+        measure_frame(400, "640x400 again");
+        done<=true;
+        wait;
+    end process;
+
+    -- VRTC (vertical retrace) covers the lines before the first visible one.
+    process
+        variable t0 : time;
+    begin
+        wait until lines480='1';
+        wait until rising_edge(vsync);
+        wait until rising_edge(vsync);
+        wait until rising_edge(vrtc);
+        t0:=now;
+        wait until falling_edge(vrtc);
+        -- 45 lines of 32 us (800 pixels at 25 MHz) = 1.44 ms
+        assert abs((now-t0)-1440 us) < 40 us
+            report "VRTC width in 480-line mode: " & time'image(now-t0) severity failure;
+        report "PASS VRTC spans the 45 blank lines: " & time'image(now-t0);
+        wait;
+    end process;
+
+    process begin wait until done for 400 ms;assert done report "watchdog" severity failure;wait;end process;
+end;
diff --git a/tests/run-crtc-lines480.sh b/tests/run-crtc-lines480.sh
